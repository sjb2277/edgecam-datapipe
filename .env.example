# 복사해서 .env로 쓴다: cp .env.example .env  (.env는 커밋하지 않는다)

# --- images (latest 금지) ---
REDPANDA_IMAGE=redpandadata/redpanda:v26.2.4
CONSOLE_IMAGE=redpandadata/console:v3.12.0
TIMESCALE_IMAGE=timescale/timescaledb:2.30.2-pg16
SEAWEEDFS_IMAGE=chrislusf/seaweedfs:4.48

# --- Redpanda (컨테이너 내부 9092/8081 고정, 호스트는 external) ---
KAFKA_EXTERNAL_HOST=localhost
KAFKA_EXTERNAL_PORT=19092
SCHEMA_REGISTRY_EXTERNAL_PORT=18081
SCHEMA_REGISTRY_URL=http://localhost:18081
CONSOLE_PORT=8080

# --- Postgres / TimescaleDB ---
POSTGRES_PORT=5432
POSTGRES_USER=pipe
POSTGRES_PASSWORD=changeme
POSTGRES_DB=pipe

# --- SeaweedFS (S3 API) ---
S3_PORT=9000
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=changeme-access-key
S3_SECRET_KEY=changeme-secret-key
SEAWEEDFS_MASTER_UI_PORT=9333
SEAWEEDFS_FILER_UI_PORT=8888
